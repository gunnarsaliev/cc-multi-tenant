DATABASE_URL=mongodb://127.0.0.1/payload-example-multi-tenant
POSTGRES_URL=postgres://127.0.0.1:5432/payload-example-multi-tenant
PAYLOAD_SECRET=PAYLOAD_MULTI_TENANT_EXAMPLE_SECRET_KEY
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
SEED_DB=true

# AI, all optional until keys are added. Without them the app runs and AI features report
# "not configured". AI_MOCK=true gives offline stand-ins outside production.
AI_MOCK=
AI_GATEWAY_API_KEY=
# Pick from https://ai-gateway.vercel.sh/v1/models, for example provider/model-name
AI_TRANSLATION_MODEL=
# Defaults to openai/text-embedding-3-small. Must produce 1536 dimensions.
AI_EMBEDDING_MODEL=
# AI Compose buttons on blog fields. Calls OpenAI directly, not through the AI Gateway.
OPENAI_API_KEY=
# Protects /api/payload-jobs/run for Vercel Cron.
CRON_SECRET=
# The eve assistant at /admin/assistant. Needs Node 24 or later.
EVE_ENABLED=
AI_AGENT_MODEL=
# Each tenant's service user's MCP key, for example {"1":"<key>"}
PAYLOAD_MCP_KEYS=
# How far a result can be from the query in vector search before it's dropped.
SEARCH_MAX_VECTOR_DISTANCE=
